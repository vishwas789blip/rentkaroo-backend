# ========================================
# RentKaroo Backend Environment Variables
# ========================================

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=https://rentkarooo.vercel.app

# Database & Cache
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/rentkaroo?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

# JWT Secrets (Ensure high-entropy secrets in production)
JWT_SECRET=your_jwt_access_secret_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars
JWT_RESET_SECRET=your_jwt_reset_secret_min_32_chars
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Email Delivery - Resend API (Recommended for Render Free - Port 443 HTTPS)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="RentKaroo" <onboarding@resend.dev>

# Email Delivery Alternative - Brevo SMTP on Port 2525
# Note: Render Free blocks ports 25, 465, and 587. Port 2525 is supported by Brevo.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_master_or_api_key

# Legacy Email (Optional Fallback)
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Rate Limiting (Optional overrides)
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
